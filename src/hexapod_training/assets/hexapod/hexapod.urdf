    <actuator name="leg5_femur_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- TIBIA TRANSMISSION -->
  <transmission name="leg5_tibia_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="leg5_tibia_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="leg5_tibia_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- COXA -->
  <link name="leg6_coxa">
    <visual>
      <geometry>
        <mesh filename="package://hexapod_description/meshes/coxa_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="magenta"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.0315 0 0"/>
      <geometry>
        <box size="0.05985 0.0513 0.042749999999999996"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0934"/>
      <origin xyz="0.02018 0.00006 -0.00074"/>
      <inertia ixx="2.3501e-05" ixy="6.6404e-10" ixz="3.6137e-07" iyy="4.3357e-05" iyz="1.7523e-08" izz="4.4608e-05"/>
    </inertial>
  </link>
  <!-- FEMUR -->
  <link name="leg6_femur">
    <visual>
      <geometry>
        <mesh filename="package://hexapod_description/meshes/femur_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="magenta"/>
    </visual>
    <collision>
      <origin rpy="0 -1.5708 0" xyz="0.05 0 0"/>
      <geometry>
        <cylinder length="0.095" radius="0.02375"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1724"/>
      <origin xyz="0.05000 0.00002 -0.00000"/>
      <inertia ixx="3.3923e-05" ixy="-4.3970e-14" ixz="-4.0729e-07" iyy="2.3291e-04" iyz="-2.4257e-14" izz="2.4153e-04"/>
    </inertial>
  </link>
  <!-- TIBIA -->
  <link name="leg6_tibia">
    <visual>
      <geometry>
        <mesh filename="package://hexapod_description/meshes/tibia_left.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="magenta"/>
    </visual>
    <!-- Foot sphere. Left unnamed: the URDF converter only applies mu1/mu2 to collisions named after the link -->
    <collision>
      <origin xyz="0.172 0 0"/>
      <geometry>
        <sphere radius="0.014"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 -1.5708 0" xyz="0.093 0 0"/>
      <geometry>
        <cylinder length="0.1767" radius="0.01615"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1034"/>
      <origin xyz="0.07831 -0.00000 0.01279"/>
      <inertia ixx="2.7891e-05" ixy="4.6243e-10" ixz="1.3841e-05" iyy="2.3494e-04" iyz="-2.0572e-10" izz="2.3960e-04"/>
    </inertial>
  </link>
  <gazebo reference="leg6_tibia">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
  </gazebo>
  <!-- COXA JOINT -->
  <joint name="leg6_coxa_joint" type="revolute">
    <parent link="base_link"/>
    <child link="leg6_coxa"/>
    <origin rpy="0 0 0.7853981633974483" xyz="0.11916 0.08952 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.94" lower="-1.57" upper="1.57" velocity="4.7"/>
  </joint>
  <!-- FEMUR JOINT -->
  <joint name="leg6_femur_joint" type="revolute">
    <parent link="leg6_coxa"/>
    <child link="leg6_femur"/>
    <origin rpy="0 0 0" xyz="0.063 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.94" lower="-1.6" upper="1.4" velocity="4.7"/>
  </joint>
  <!-- TIBIA JOINT -->
  <joint name="leg6_tibia_joint" type="revolute">
    <parent link="leg6_femur"/>
    <child link="leg6_tibia"/>
    <origin rpy="0 1.5708 0" xyz="0.1 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.94" lower="-2.35" upper="1.06" velocity="4.7"/>
  </joint>
  <!-- COXA TRANSMISSION -->
  <transmission name="leg6_coxa_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="leg6_coxa_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="leg6_coxa_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- FEMUR TRANSMISSION -->
  <transmission name="leg6_femur_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="leg6_femur_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="leg6_femur_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- TIBIA TRANSMISSION -->
  <transmission name="leg6_tibia_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="leg6_tibia_joint">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="leg6_tibia_motor">
      <hardwareInterface>PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- ================= SENSORS ================= -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.152</horizontal_fov>
        <!-- Pi Camera Module 3 standard lens: 66 deg -->
        <image>
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>100</far>
        </clip>
      </camera>
      <topic>/camera/image</topic>
      <gz_frame_id>camera_link</gz_frame_id>
    </sensor>
  </gazebo>
  <gazebo reference="front_depth_camera_link">
    <sensor name="front_depth_camera" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>8</update_rate>
      <camera>
        <horizontal_fov>1.021</horizontal_fov>
        <!-- Arducam ToF: 70 deg diagonal = 58.5 deg horizontal -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>4.0</far>
          <!-- far mode -->
        </clip>
      </camera>
      <topic>/front_depth</topic>
      <gz_frame_id>front_depth_camera_link</gz_frame_id>
    </sensor>
  </gazebo>
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.015 0.015 0.005"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.015 0.015 0.005"/>
      </geometry>
    </collision>
    <!-- Its mass is in base_link's inertial (hexapod.inertials.xacro); fixed joints are merged into base_link -->
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.03"/>
  </joint>
  <gazebo reference="imu_link">
    <!-- 1000 Hz (the physics rate): Gazebo's gyro is an instantaneous sample, and the body's
       yaw rate jerks with each footstep, so 100 Hz under-reads turns by ~9%. The real ISM330DHCX
       filters internally, so its 100 Hz readings don't have this problem. -->
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.02</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.02</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.02</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="mag_sensor" type="magnetometer">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/imu/mag</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder length="0.041" radius="0.038"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.041" radius="0.038"/>
      </geometry>
    </collision>
    <!-- Its mass is in base_link's inertial (hexapod.inertials.xacro); fixed joints are merged into base_link -->
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.067"/>
  </joint>
  <link name="front_depth_camera_link">
    <visual>
      <geometry>
        <box size="0.01 0.038 0.038"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.038 0.038"/>
      </geometry>
    </collision>
    <!-- Its mass is in base_link's inertial (hexapod.inertials.xacro); fixed joints are merged into base_link -->
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="front_depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_depth_camera_link"/>
    <origin rpy="0 0.0 0" xyz="0.138 0 -0.0124"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.01 0.025 0.024"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.025 0.024"/>
      </geometry>
    </collision>
    <!-- Its mass is in base_link's inertial (hexapod.inertials.xacro); fixed joints are merged into base_link -->
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0.0 0" xyz="0.138 0 0.0257"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <!-- RPLIDAR A2M12: 10 Hz, 16 kHz sampling (0.225 deg steps), 0.2-12 m -->
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>1600</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <!-- 1 = 2D lidar, increase for 3D -->
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <topic>/lidar/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!--
    ros2_control hardware for the 18 leg joints.

    hardware:
      gazebo  Gazebo Harmonic (gz_ros2_control)
      mock    ros2_control mock hardware, commands are mirrored straight to the states
      st3215  Waveshare ST3215 serial bus servos (hexapod_hardware_interface)
  -->
  <ros2_control name="HexapodHardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="leg1_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg1_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg1_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg2_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg2_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg2_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg3_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg3_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg3_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg4_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg4_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg4_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg5_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg5_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg5_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg6_coxa_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg6_femur_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="leg6_tibia_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters></parameters>
    </plugin>
  </gazebo>
  <!-- The robot's true pose, for scoring test runs (scenario_runner.py) against odometry -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <tf_topic>/ground_truth/tf</tf_topic>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>
</robot>
